# ── Database ──────────────────────────────────────────────────────
# Local (Docker): postgresql://carekan:carekan@localhost:5432/carekan?schema=public
# Supabase: ใช้ pooler (port 6543) เป็น DATABASE_URL และ direct (5432) เป็น DIRECT_URL
DATABASE_URL="postgresql://carekan:carekan@localhost:5432/carekan?schema=public"
# จำเป็นเฉพาะตอนใช้ Supabase — prisma migrate ต้องต่อตรง ไม่ผ่าน pooler
# DIRECT_URL=""

# ── App ───────────────────────────────────────────────────────────
JWT_SECRET=""
PORT=4000

# ── LINE (optional — webhook ตอบ 401 จนกว่าจะตั้งค่า) ─────────────
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_TOKEN=""
LIFF_ID=""

# ── Google Sheets — for API key request form submissions ──────────
# Deploy your Apps Script as a web app, paste the URL here.
# Leave blank to disable sheet logging (form will still submit successfully).
GOOGLE_APPS_SCRIPT_URL=""
