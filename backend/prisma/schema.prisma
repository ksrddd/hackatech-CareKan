generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InsuranceRight {
  uc
  sso
  csmbs
  self_pay
}

enum Sex {
  male
  female
  unspecified
}

enum ServiceType {
  opd
  new_patient
  checkup
  follow_up
  lab
  medication
  elderly
}

enum Zone {
  inner
  north
  south
  east
  thon_north
  thon_south
}

enum ClinicCode {
  med
  surg
  ped
  ob
  ortho
  eye
  ent
  dent
  skin
  ncd
  psych
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

enum ApiKeyRequestStatus {
  pending_email
  email_verified
  approved
  rejected
  revoked
}

enum ApiKeyScope {
  read_queue
}

model User {
  id          String    @id @default(cuid())
  nationalId  String    @unique @map("national_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phoneNumber String    @map("phone_number")
  email       String    @unique
  password    String
  birthDate   String    @map("birth_date")
  sex         Sex       @default(unspecified)
  consentAt   DateTime? @map("consent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  reserves       Reserve[]
  apiKeyRequests ApiKeyRequest[]
  apiKeys        ApiKey[]

  @@map("users")
}

model ApiKeyRequest {
  id                    String              @id @default(cuid())
  userId                String              @map("user_id")
  organizationName      String              @map("organization_name")
  staffFullName         String              @map("staff_full_name")
  position              String
  organizationEmail     String              @map("organization_email")
  contactPhone          String              @map("contact_phone")
  referenceNumber       String?             @map("reference_number")
  purpose               String
  driveLinks            String[]            @map("drive_links")
  status                ApiKeyRequestStatus @default(pending_email)
  verificationTokenHash String?             @map("verification_token_hash")
  verificationExpiresAt DateTime?           @map("verification_expires_at")
  verifiedAt            DateTime?           @map("verified_at")
  rejectedReason        String?             @map("rejected_reason")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  apiKeys ApiKey[]

  @@index([userId, status])
  @@map("api_key_requests")
}

model ApiKey {
  id               String      @id @default(cuid())
  requestId        String      @map("request_id")
  userId           String      @map("user_id")
  organizationName String      @map("organization_name")
  prefix           String      @map("prefix")
  hash             String      @map("hash")
  scope            ApiKeyScope @default(read_queue)
  revokedAt        DateTime?   @map("revoked_at")
  lastUsedAt       DateTime?   @map("last_used_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id])
  request ApiKeyRequest    @relation(fields: [requestId], references: [id])
  usage   ApiKeyUsageLog[]

  @@unique([hash])
  @@index([userId])
  @@index([requestId])
  @@map("api_keys")
}

model ApiKeyUsageLog {
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  endpoint   String
  method     String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  statusCode Int      @map("status_code")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
  @@map("api_key_usage_logs")
}

model Hospital {
  id             String           @id
  code           String
  name           String           @map("hospital_name")
  shortName      String           @map("short_name")
  address        String
  district       String
  zone           Zone
  phone          String
  openingHours   String           @map("opening_hours")
  description    String
  services       ServiceType[]
  rightsAccepted InsuranceRight[] @map("rights_accepted")
  mockDistanceKm Float            @map("mock_distance_km")

  schedules Schedule[]
  reserves  Reserve[]

  @@map("hospitals")
}

model Schedule {
  id            String     @id @default(cuid())
  hospitalId    String     @map("hospital_id")
  clinic        ClinicCode
  date          String
  startTime     String     @map("start_time")
  endTime       String     @map("end_time")
  maxCapacity   Int        @map("max_capacity")
  currentBooked Int        @default(0) @map("current_booked")
  isFull        Boolean    @default(false) @map("is_full")

  hospital Hospital  @relation(fields: [hospitalId], references: [id])
  reserves Reserve[]

  @@unique([hospitalId, clinic, date, startTime], name: "slot_identity")
  @@index([hospitalId, clinic, date])
  @@map("schedules")
}

model Reserve {
  id          String            @id @default(cuid())
  bookingCode String            @unique @map("booking_code")
  userId      String            @map("user_id")
  hospitalId  String            @map("hospital_id")
  scheduleId  String            @map("schedule_id")
  purpose     ServiceType
  reason      String            @default("")
  status      AppointmentStatus @default(confirmed)
  queueNumber String            @map("queue_number")
  createdAt   DateTime          @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  schedule Schedule @relation(fields: [scheduleId], references: [id])

  @@index([hospitalId, scheduleId])
  @@map("reserves")
}
